        <template><![CDATA[<div class="panel panel-default">
  <div class="panel-heading">
    <h3>{{data.service.name}}
      <span class="label" ng-class="{'label-success': data.service.risk=='green',
        'label-warning': data.service.risk=='yellow', 'label-danger': data.service.risk=='red',
        'label-default': data.service.risk=='not_assessed'}">{{data.service.risk}}</span></h3>
    <small>Owner: {{data.service.owner}} · Coverage {{data.service.coverage}}% ·
           Implemented {{data.service.implemented}}% · Updated {{data.service.last}}</small>
  </div>
  <table class="table table-striped">
    <tr><th>Control</th><th>Ref</th><th>Framework</th><th>Status</th><th>Owner</th><th>Evidence</th></tr>
    <tr ng-repeat="m in data.mappings">
      <td>{{m.control}}</td><td>{{m.ref}}</td><td>{{m.framework}}</td>
      <td><span class="label label-{{m.flag=='ok'?'success':m.flag=='missing'?'default':'warning'}}">{{m.status}}</span></td>
      <td>{{m.owner}}</td>
      <td><span ng-repeat="e in m.evidence" class="chip">
            {{e.title}} ({{e.state}}, until {{e.until}})
            <a ng-repeat="f in e.files" href="{{f.link}}" target="_blank">]]>📎<![CDATA[{{f.name}}</a>
          </span>
          <span ng-if="!m.evidence.length" class="text-danger">No evidence — gap</span></td>
    </tr>
  </table>
  <div class="panel-footer">
    <strong>Open gaps ({{data.gaps.length}}):</strong>
    <span ng-repeat="g in data.gaps" class="label label-warning">{{g}}</span>
    <span ng-if="!data.gaps.length" class="text-success">None ]]>🎉<![CDATA[</span>
  </div>
</div>
<!-- below: embed widget "cpm_evidence_upload" (it reads the same sys_id param) -->]]></template>
