        <script><![CDATA[(function() {
  var pid = $sp.getParameter('sys_id');           // posture row sys_id
  var p = new GlideRecordSecure('x_1929776_compli_0_service_posture');
  if (!pid || !p.get(pid)) { data.error = 'Service not found'; return; }

  data.service = {
    name: p.business_service.getDisplayValue(),
    owner: p.business_service.managed_by.getDisplayValue() || 'Unassigned',
    risk: p.getValue('risk_level'),
    coverage: parseInt(p.getValue('coverage_pct'), 10),
    implemented: parseInt(p.getValue('implemented_pct'), 10),
    total: parseInt(p.getValue('total_controls'), 10),
    last: p.getDisplayValue('last_calculated')
  };
  var svcId = p.getValue('business_service');

  data.mappings = []; data.gaps = [];
  var m = new GlideRecordSecure('x_1929776_compli_0_mapping');
  m.addQuery('business_service', svcId);
  m.orderBy('control');
  m.query();
  while (m.next()) {
    var item = { sys_id: m.getUniqueValue(),
                 control: m.control.getDisplayValue(),
                 ref: m.control.getValue('control_reference') || '',
                 framework: m.control.getDisplayValue('framework'),
                 status: m.getDisplayValue('implementation_status'),
                 owner: m.owner.getDisplayValue() || '—',
                 evidence: [], flag: 'missing' };

    var ev = new GlideRecordSecure('x_1929776_compli_0_evidence');
    ev.addQuery('mapping', m.getUniqueValue());
    ev.orderByDesc('valid_until');
    ev.query();
    while (ev.next()) {
      var files = [];
      var att = new GlideRecord('sys_attachment');
      att.addQuery('table_name', 'x_1929776_compli_0_evidence');
      att.addQuery('table_sys_id', ev.getUniqueValue());
      att.query();
      while (att.next())
        files.push({ name: att.getValue('file_name'),
                     link: '/sys_attachment.do?sys_id=' + att.getUniqueValue() });
      item.evidence.push({ title: ev.getDisplayValue(), state: ev.getValue('state'),
                           until: ev.getDisplayValue('valid_until'), files: files });
      if (ev.getValue('state') == 'valid') item.flag = 'ok';
      else if (ev.getValue('state') == 'expiring' && item.flag != 'ok') item.flag = 'expiring';
      else if (ev.getValue('state') == 'expired' && item.flag == 'missing') item.flag = 'expired';
    }
    if (item.flag != 'ok') data.gaps.push(item.control + ' — ' + item.flag);
    data.mappings.push(item);
  }
})();]]></script>
