        <script><![CDATA[// Role: the only scheduled work of the app. Each step is isolated, so a failure is logged and the next step still runs.
var steps = [
  ['refresh owners from the CMDB', function() { new CPMMapping().refreshOwners(); }],
  ['expire stale evidence',        function() { new CPMMapping().expire(); }],
  ['remove abandoned drafts',      function() { new CPMEvidence().cleanupDrafts(); }],
  ['send reminders to owners',     function() { new CPMNotify().run(); }]
];
steps.forEach(function(step) {
  try {
    step[1]();
    gs.info('[CPM] ' + step[0] + ': done');
  } catch (e) {
    gs.error('[CPM] ' + step[0] + ': failed, ' + e.message);
  }
});]]></script>
